# fine-grained github token for your test repo (pull requests: read and write)
GITHUB_TOKEN=

# long random password shared by github and this server
# make one with: python3 -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# claude api key (create it inside a workspace, e.g. Default)
ANTHROPIC_API_KEY=

# model that does the review
CLAUDE_MODEL=claude-sonnet-5-5
